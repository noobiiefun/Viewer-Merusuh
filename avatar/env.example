# ============================================================
# Avatar Overlay — Environment Variables
# Salin file ini menjadi .env dan isi sesuai kebutuhan
# ============================================================

# Port server avatar (jangan samakan dengan Viewer Merusuh :3000)
PORT=3500

# --- YouTube ---
# Phase 1: pakai youtube-chat (tidak butuh API key)
# Phase 2: upgrade ke YouTube Data API v3
# YT_API_KEY=

# Interval polling chat YouTube (milliseconds)
POLL_INTERVAL_MS=3000

# --- Overlay Config ---
# Maksimum avatar yang tampil bersamaan di OBS
MAX_AVATARS=8

# Lama speech bubble tampil (ms)
BUBBLE_DURATION_MS=5000

# Lama avatar idle sebelum exit layar (ms)
IDLE_DURATION_MS=12000

# Pixel scale untuk sprite avatar (1 = asli, 2 = 2x, dst)
AVATAR_SCALE=2

# --- Keamanan (untuk integrasi RC Module nanti) ---
# AVATAR_INTERNAL_KEY=ganti_dengan_secret_random
