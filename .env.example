# ==================================================
# Viewer Merusuh — Environment Configuration
# Copy file ini jadi .env lalu sesuaikan isinya
# ==================================================

# ── PORT SERVER ────────────────────────────────────
# Ganti jika port 3000 bentrok dengan aplikasi lain
# Contoh port alternatif yang umum kosong: 3001, 3030, 4000, 5000, 8080
PORT=3000

# ── SAWERIA ────────────────────────────────────────
# Ambil dari: https://saweria.co/dashboard > Stream Key
SAWERIA_STREAM_KEY=your_saweria_stream_key_here

# ── TRAKTEER ───────────────────────────────────────
# Ambil dari: https://trakteer.id/manage/integration
TRAKTEER_API_KEY=your_trakteer_api_key_here

# ── AUTOHOTKEY ─────────────────────────────────────
# Path AutoHotkey v2 di PC kamu
# Cek instalasi: default-nya ada di sini:
AHK_EXE_PATH=C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe

# ── MODE ───────────────────────────────────────────
# "development" = log verbose + test endpoint aktif
# "production"  = test endpoint dinonaktifkan
NODE_ENV=development
