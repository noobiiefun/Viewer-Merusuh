# ==================================================
# Viewer Merusuh — Environment Configuration
# Copy file ini jadi .env dan isi sesuai kebutuhan
# ==================================================

# Port server (default: 3000)
PORT=3000

# === SAWERIA ===
# Stream key dari dashboard Saweria kamu
# https://saweria.co/dashboard > Webhook
SAWERIA_STREAM_KEY=your_saweria_stream_key_here

# === TRAKTEER ===
# API Key dari dashboard Trakteer
# https://trakteer.id/manage/integration
TRAKTEER_API_KEY=your_trakteer_api_key_here

# === KEAMANAN ===
# Secret key untuk validasi webhook (bebas isi, minimal 32 karakter)
WEBHOOK_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter

# === MODE ===
# "production" atau "development"
# Development mode: log lebih verbose, test endpoint aktif
NODE_ENV=development
