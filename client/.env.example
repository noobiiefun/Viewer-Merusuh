# ── Koneksi Server ───────────────────────────────────────────────────────────
# IP dan port PC Server (PC OBS)
# LAN    : http://192.168.1.10:3000
# ngrok  : https://abc123.ngrok.io
SERVER_URL=http://192.168.1.10:3000

# Secret yang sama dengan CLIENT_SECRET di .env server
CLIENT_SECRET=rahasia_yang_panjang_dan_unik

# Nama client (muncul di log server)
CLIENT_NAME=GamePC

# ── Adapters ─────────────────────────────────────────────────────────────────
ADAPTER_AHK=true
ADAPTER_VJOY=false
ADAPTER_PLUGIN=false

# ── AutoHotkey ───────────────────────────────────────────────────────────────
# Path ke AutoHotkey v2 executable
AHK_EXE_PATH=C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe

# (Opsional) Override path folder script .ahk
# Default: <client_root>/adapters/ahk/
# AHK_SCRIPTS_PATH=D:\GameEffects\ahk

# Set true untuk test tanpa menjalankan AHK sungguhan
AHK_DRY_RUN=false

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# (Opsional) Override folder log per-script AHK
# Default: <client_root>/logs/ahk/
# LOG_DIR=D:\logs\viewer-merusuh
