# =============================================================
# Viewer Merusuh — CLIENT CONFIG
# =============================================================
# Salin file ini menjadi .env lalu sesuaikan isinya.
# Jangan commit file .env ke git!
# =============================================================

# ---------------------------------------------------------------
# KONEKSI SERVER
# ---------------------------------------------------------------
# IP dan port dari PC Server (PC OBS yang menjalankan Viewer Merusuh)
# Contoh LAN  : SERVER_URL=http://192.168.1.10:3000
# Contoh IP   : SERVER_URL=http://103.x.x.x:3000
SERVER_URL=http://192.168.1.10:3000

# Token autentikasi — harus sama persis dengan CLIENT_SECRET di .env server
# Gunakan string acak yang panjang dan unik
CLIENT_SECRET=ganti_dengan_secret_yang_sama_seperti_di_server

# ---------------------------------------------------------------
# IDENTITAS CLIENT
# ---------------------------------------------------------------
# Nama client ini (muncul di log server)
CLIENT_NAME=GamePC

# ---------------------------------------------------------------
# ADAPTER YANG AKTIF
# ---------------------------------------------------------------
# Aktifkan adapter sesuai kebutuhan (true / false)
ADAPTER_AHK=true
ADAPTER_VJOY=false
ADAPTER_PLUGIN=false

# ---------------------------------------------------------------
# AHK ADAPTER
# ---------------------------------------------------------------
# Path ke executable AutoHotkey v2
AHK_EXE_PATH=C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe

# Path ke folder scripts AHK (relatif dari root client atau absolut)
# Default: menggunakan folder adapters/ahk/ di dalam proyek ini
AHK_SCRIPTS_PATH=

# ---------------------------------------------------------------
# PLUGIN ADAPTER (opsional)
# ---------------------------------------------------------------
# Port lokal tempat game plugin bisa polling efek
PLUGIN_LOCAL_PORT=3001

# ---------------------------------------------------------------
# LOG
# ---------------------------------------------------------------
# Level log: debug | info | warn | error
LOG_LEVEL=info
