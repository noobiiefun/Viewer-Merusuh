# ─────────────────────────────────────────
#  Viewer Merusuh CLIENT — .env.example
#  Salin file ini menjadi .env lalu isi nilainya
# ─────────────────────────────────────────

# IP dan port PC Server (PC OBS)
SERVER_URL=http://192.168.1.10:3000

# Secret yang sama dengan CLIENT_SECRET di .env server
CLIENT_SECRET=rahasia_yang_panjang_dan_unik

# Nama client (muncul di log server)
CLIENT_NAME=GamePC

# ── Adapter Toggle ──────────────────────────────────────
ADAPTER_AHK=true
ADAPTER_VJOY=false
ADAPTER_PLUGIN=false

# ── AHK Config ─────────────────────────────────────────
AHK_EXE_PATH=C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe

# ── vJoy Config ────────────────────────────────────────
# Requirement: ViGEmBus driver + npm install vigemclient
# https://github.com/nefarius/ViGEmBus/releases
VJOY_CONTROLLER_TYPE=DS4

# ── Plugin Config ──────────────────────────────────────
PLUGIN_LOCAL_PORT=3001
# Token auth untuk game plugin (kosongkan = tanpa auth)
PLUGIN_TOKEN=
# Efek kadaluarsa setelah N ms jika belum diambil plugin
PLUGIN_EFFECT_TTL=30000

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=info

# ── Dashboard Config (Step 5) ───────────────────────────
# Web UI di http://localhost:3002
# Set false untuk nonaktifkan
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3002
