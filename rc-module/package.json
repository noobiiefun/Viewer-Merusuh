{
  "name": "rc-module",
  "version": "0.2.0",
  "description": "RC/Drone control extension for Viewer Merusuh",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "simulator": "RC_PORT=3001 node api/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand"
  },
  "keywords": ["rc", "drone", "streaming", "viewer-merusuh"],
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/", "/data/"]
  },
  "phasePlanned": {
    "phase3": {
      "ws": "^8.16.0",
      "note": "Tambahkan untuk ESP32 WebSocket adapter"
    },
    "phase4": {
      "mediasoup": "^3.x",
      "fluent-ffmpeg": "^2.1.3",
      "note": "Untuk WebRTC / HLS camera streaming"
    },
    "phase4_drone": {
      "mavlink": "^1.0.x",
      "note": "Untuk kontrol drone via MAVLink protocol"
    }
  }
}
