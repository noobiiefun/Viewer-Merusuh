{
  "name": "viewer-merusuh",
  "version": "1.0.0",
  "description": "Platform interaktif untuk livestreamer — viewer bisa merusuh saat streaming game via donasi",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "setup": "node installer/setup.js",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build": "cd dashboard && npm install && npm run build",
    "build:exe": "npm run build && pkg server/index.js --config pkg.config.json --output dist-exe/viewer-merusuh.exe",
    "package": "node installer/make-release.js",
    "postinstall": "node installer/postinstall.js",
    "electron:dev": "electron .",
    "electron:build": "node build-electron.js",
    "build:full": "npm run build && npm run electron:build"
  },
  "keywords": [
    "streaming",
    "donation",
    "game",
    "tiktok",
    "saweria",
    "trakteer",
    "crowd-control"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ngrok": "^5.0.0-beta.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "28.3.3",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.0"
  },
  "optionalDependencies": {
    "vigemclient": "^1.5.3"
  },
  "bin": {
    "viewer-merusuh": "server/index.js"
  }
}
